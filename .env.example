# Copy to .env and fill in. NEVER commit .env.
#
# --- local development (uvicorn, SQLite) ---
TORMAIL_ENV=development
TORMAIL_DATABASE_URL=sqlite:///./dev.db
TORMAIL_BIND_HOST=127.0.0.1
TORMAIL_BIND_PORT=8000
TORMAIL_COOKIE_SECURE=true

# --- used by docker compose (production stack) and for local runs ---
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
TORMAIL_SECRET_KEY=
# Hex only (it is embedded in a URL). Generate:  python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=
